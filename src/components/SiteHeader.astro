---
import ThemeToggle from "./ThemeToggle.astro";
const path = Astro.url.pathname;
const links = [
  ["/","Home"],
  ["/projects","Projects"],
  ["/support-projects","Support Projects"],
  ["/student-archive","Student Archive"],
  ["/case-studies","Case Studies"],
  ["/about","About"],
  ["/contact","Contact"]
];
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="Codie Shannon home">
      <img src="/icons/mark.svg" alt="" width="30" height="30"/>
      <span><b>CODIE SHANNON</b><small>SOFTWARE / SYSTEMS</small></span>
    </a>
    <nav aria-label="Primary navigation">
      {links.map(([href,label]) =>
        <a class:list={["nav-link",{active:href==="/"?path==="/":path.startsWith(href)}]} href={href}>{label}</a>
      )}
    </nav>
    <div class="actions">
      <ThemeToggle/>
      <a class="cv" href="/cv.pdf">CV <span>^</span></a>
    </div>
  </div>
</header>
<style>
.site-header{position:sticky;top:0;z-index:30;border-bottom:1px solid color-mix(in srgb,var(--line) 86%,transparent);background:color-mix(in srgb,var(--bg) 80%,transparent);backdrop-filter:blur(20px)}
.nav-wrap{min-height:72px;display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:22px;align-items:center}
.brand{display:flex;align-items:center;gap:11px;white-space:nowrap}.brand img{filter:drop-shadow(0 0 10px color-mix(in srgb,var(--accent) 30%,transparent))}
.brand span{display:flex;flex-direction:column;gap:2px}.brand b{font-size:.72rem;letter-spacing:.14em}.brand small{font-size:.54rem;color:var(--muted);letter-spacing:.15em}
nav{display:flex;justify-content:center;gap:1px;min-width:0}.nav-link{position:relative;padding:10px 8px;color:var(--muted);font-size:.75rem;font-weight:750;white-space:nowrap}
.nav-link::after{content:"";position:absolute;left:8px;right:8px;bottom:2px;height:1px;background:var(--accent);transform:scaleX(0);transition:transform .18s ease}
.nav-link:hover,.nav-link.active{color:var(--text)}.nav-link.active::after{transform:scaleX(1)}
.actions{display:flex;gap:8px;align-items:center}.cv{min-height:40px;display:inline-flex;align-items:center;gap:6px;padding:0 13px;border-radius:8px;border:1px solid var(--line-strong);background:var(--panel);font-size:.76rem;font-weight:800}
@media(max-width:1160px){.nav-wrap{grid-template-columns:1fr auto}nav{order:3;grid-column:1/-1;justify-content:flex-start;overflow-x:auto;padding-bottom:9px;scrollbar-width:thin}.cv{display:none}}
</style>
