---
import type { RepoDetail } from "../data/repoDetails";
interface Props { detail?: RepoDetail; }
const { detail } = Astro.props;
---
{detail && (
<section class="readme panel tech-corners">
  <div class="readme-head">
    <div><p class="eyebrow">Repository readme / adapted</p><h2>{detail.title}</h2></div>
    <div class="source-note"><span>SOURCE</span><b>README.md</b><small>Adapted for portfolio readability; claims remain source-derived.</small></div>
  </div>
  {detail.overview.length > 0 && <div class="overview">{detail.overview.map(p => <p>{p}</p>)}</div>}
  <div class="readme-sections">
    {detail.sections.map((section,index) => (
      <article>
        <div class="section-index">{String(index+1).padStart(2,"0")}</div>
        <div>
          <p class="kicker">{section.heading}</p>
          {section.paragraphs.map(p => <p>{p}</p>)}
          {section.bullets.length > 0 && <ul>{section.bullets.map(item => <li>{item}</li>)}</ul>}
          {section.code.length > 0 && <div class="code-list">{section.code.map(line => <code>{line}</code>)}</div>}
        </div>
      </article>
    ))}
  </div>
  <div class="readme-footer"><span>Last source sync</span><b>{detail.syncedAt}</b><span>Repository</span><a href={detail.github} target="_blank" rel="noreferrer">{detail.repoName} ^</a></div>
</section>
)}
<style>
.readme{margin-top:18px;padding:28px;overflow:hidden}.readme-head{display:grid;grid-template-columns:1fr minmax(220px,.35fr);gap:40px;padding-bottom:28px;border-bottom:1px solid var(--line)}
.readme-head h2{font-family:var(--font-display);font-size:clamp(2rem,5vw,4rem);letter-spacing:-.045em;margin:4px 0 0}.source-note{border-left:1px solid var(--line);padding-left:20px;display:flex;flex-direction:column;gap:6px}
.source-note span{color:var(--muted);font-size:.57rem;letter-spacing:.14em}.source-note b{font:700 .78rem ui-monospace,SFMono-Regular,monospace}.source-note small{color:var(--muted);line-height:1.45}
.overview{max-width:950px;padding:28px 0 8px}.overview p{color:var(--muted-strong);font-size:1.02rem;line-height:1.75;margin:0 0 14px}.readme-sections{display:grid;gap:0;margin-top:12px}
.readme-sections article{display:grid;grid-template-columns:70px 1fr;gap:22px;padding:25px 0;border-top:1px solid var(--line)}.section-index{color:var(--accent);font:700 .78rem ui-monospace,SFMono-Regular,monospace}
.readme-sections p{color:var(--muted-strong);line-height:1.7;margin:10px 0}.readme-sections ul{list-style:none;padding:0;margin:14px 0 0}.readme-sections li{padding:9px 0;border-top:1px solid color-mix(in srgb,var(--line) 70%,transparent);color:var(--muted-strong);line-height:1.55}
.readme-sections li::before{content:"->";color:var(--accent);margin-right:10px}.code-list{display:grid;gap:5px;margin-top:14px}.code-list code{display:block;padding:9px 11px;background:var(--bg-elevated);border:1px solid var(--line);border-radius:6px;color:var(--accent-strong);font-size:.72rem;overflow-x:auto}
.readme-footer{display:grid;grid-template-columns:auto 1fr;gap:7px 18px;padding-top:22px;border-top:1px solid var(--line);font-size:.72rem}.readme-footer span{color:var(--muted)}.readme-footer a{color:var(--accent-strong);font-weight:800}
@media(max-width:760px){.readme{padding:20px}.readme-head{grid-template-columns:1fr}.source-note{border-left:0;border-top:1px solid var(--line);padding:16px 0 0}.readme-sections article{grid-template-columns:1fr;gap:8px}}
</style>
