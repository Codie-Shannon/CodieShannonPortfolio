---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ProofWall from "../components/ProofWall.astro";
import { featuredProjects } from "../data/projects";
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <div class="hero-index"><span>PORTFOLIO / 2026</span><i></i><span>WHK  ·  NZ</span></div>
        <p class="eyebrow">Software  ·  systems  ·  controlled operation</p>
        <h1 class="display">I build practical<br/><span>systems that solve</span><br/>real problems.</h1>
        <p class="lead">Software developer and systems contractor building operational tools, workflow automation, integrations and product-grade proof across .NET, web, data and hardware-facing work.</p>
        <div class="hero-actions">
          <a class="button primary" href="/projects">View projects <span>-></span></a>
          <a class="button ghost" href="/case-studies">Inspect case studies</a>
        </div>
        <div class="capability-strip">
          <div><span>01</span><b>.NET & C#</b><small>Desktop / web / systems</small></div>
          <div><span>02</span><b>Workflow automation</b><small>Human-reviewed operation</small></div>
          <div><span>03</span><b>Business systems</b><small>Data / evidence / reporting</small></div>
          <div><span>04</span><b>Engineering breadth</b><small>Python / Node / Unity</small></div>
        </div>
      </div>

      <aside class="hero-system panel tech-corners">
        <div class="system-head"><span class="mono">LIVE PORTFOLIO SYSTEM</span><span><i class="status-dot"></i> ONLINE</span></div>
        <div class="orbit" aria-hidden="true">
          <div class="orbit-ring r1"></div><div class="orbit-ring r2"></div><div class="orbit-ring r3"></div>
          <div class="node n1"></div><div class="node n2"></div><div class="node n3"></div><div class="node core">CS</div>
        </div>
        <div class="system-list">
          <div><span>FLAGSHIP</span><b>LifeOS</b></div>
          <div><span>ARCHIVE</span><b>Family Archive</b></div>
          <div><span>BUSINESS</span><b>OperationsFlow</b></div>
          <div><span>DESKTOP</span><b>Media Manager</b></div>
        </div>
        <div class="telemetry"><span>BUILD</span><i></i><span>EVIDENCE</span><i></i><span>SHIP</span></div>
      </aside>
    </div>
    <div class="container lower-signal"><span>SCROLL / INSPECT</span><i></i><span>PUBLIC-SAFE EVIDENCE</span></div>
  </section>

  <div class="container"><ProofWall/></div>

  <section class="featured container">
    <div class="section-head">
      <div><p class="eyebrow">Selected systems</p><h2 class="section-title">Built to be<br/>inspected.</h2></div>
      <div class="section-copy"><p>Flagship products, business systems, restored desktop work and technical breadth -- weighted by proof, not presented as a flat repository dump.</p><a href="/projects">Explore all public projects -&gt;</a></div>
    </div>
    <div class="project-grid">
      {featuredProjects.map((project,index) => <ProjectCard project={project} index={index} large={index<2}/>)}
    </div>
  </section>

  <section class="proof-band section-rule">
    <div class="container proof-grid">
      <div class="proof-heading"><p class="eyebrow">How the work reads</p><h2 class="section-title">Problem -> system -> proof.</h2></div>
      <div class="proof-steps">
        <article><span>01</span><h3>Operational problem</h3><p>Start from real constraints, not a showcase feature list.</p></article>
        <article><span>02</span><h3>Controlled implementation</h3><p>Clear boundaries, explicit state and human review where it matters.</p></article>
        <article><span>03</span><h3>Visible evidence</h3><p>Builds, tests, screenshots, release closure and limitations.</p></article>
      </div>
    </div>
  </section>

  <section class="case-band container">
    <div class="case-heading">
      <p class="eyebrow">Case studies</p>
      <h2 class="section-title">Context before screenshots.</h2>
      <p class="lead">The strongest work is explained through constraints, implementation decisions, evidence and honest boundaries.</p>
    </div>
    <div class="case-grid">
      <a class="case-card panel tech-corners" href="/projects/lifeos"><span class="number">01 / FLAGSHIP</span><h3>LifeOS</h3><p>One platform for visible operational state across work, money, projects, follow-ups and evidence.</p><b>Inspect system -></b></a>
      <a class="case-card panel tech-corners" href="/projects/family-archive"><span class="number">02 / ARCHIVE</span><h3>Family Archive</h3><p>Preservation-first media architecture with role boundaries, integrity and controlled public proof.</p><b>Inspect system -></b></a>
      <a class="case-card panel tech-corners" href="/projects/operationsflow"><span class="number">03 / BUSINESS</span><h3>OperationsFlow</h3><p>Business operations modeled as connected records, actions, risk, training and reporting.</p><b>Inspect system -></b></a>
    </div>
  </section>

  <section class="container portfolio-lanes">
    <a class="lane panel tech-corners" href="/support-projects"><span>SUPPORT PROJECTS</span><h2>Focused tools and engineering labs.</h2><p>Smaller repositories prove specific technical capabilities without competing with the flagship systems.</p><b>Explore support projects -&gt;</b></a>
    <a class="lane panel tech-corners" href="/student-archive"><span>STUDENT ARCHIVE</span><h2>Earlier work, preserved in context.</h2><p>Diploma and student projects show progression and breadth while staying separate from current professional proof.</p><b>Open student archive -&gt;</b></a>
  </section>

  <section class="container contact-cta panel tech-corners">
    <div><p class="eyebrow">Available for work</p><h2>Need a useful system built -- not another dashboard nobody trusts?</h2></div>
    <a class="button primary" href="/contact">Start a conversation -></a>
  </section>
</BaseLayout>

<style>
.hero{padding:84px 0 34px;min-height:calc(100vh - 72px);display:flex;flex-direction:column;justify-content:center}
.hero-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(350px,.45fr);gap:56px;align-items:stretch}
.hero-copy{padding:20px 0}.hero-index{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;margin-bottom:54px;color:var(--muted);font-size:.62rem;letter-spacing:.15em}.hero-index i{height:1px;background:var(--line)}
.display span{color:var(--accent-strong)}.hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:34px}
.capability-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:70px;border-block:1px solid var(--line)}
.capability-strip>div{position:relative;padding:17px 15px 18px;border-right:1px solid var(--line)}.capability-strip>div:first-child{padding-left:0}.capability-strip>div:last-child{border-right:0}
.capability-strip span{display:block;color:var(--accent);font:.62rem ui-monospace,SFMono-Regular,monospace}.capability-strip b{display:block;margin-top:11px;font-size:.78rem}.capability-strip small{display:block;margin-top:5px;color:var(--muted);font-size:.65rem;line-height:1.4}
.hero-system{padding:18px;min-height:560px;display:flex;flex-direction:column;overflow:hidden}.system-head{display:flex;justify-content:space-between;gap:16px;color:var(--muted);font-size:.62rem;letter-spacing:.1em}.system-head>span:last-child{display:flex;align-items:center;gap:8px;color:var(--success)}
.orbit{position:relative;height:260px;margin:28px 0 12px}.orbit-ring{position:absolute;left:50%;top:50%;border:1px solid color-mix(in srgb,var(--accent) 24%,var(--line));border-radius:50%;transform:translate(-50%,-50%)}.r1{width:90px;height:90px}.r2{width:170px;height:170px}.r3{width:245px;height:245px}
.node{position:absolute;width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 18px var(--accent)}.core{left:50%;top:50%;width:58px;height:58px;transform:translate(-50%,-50%);display:grid;place-items:center;background:var(--panel-strong);border:1px solid var(--accent);font-family:var(--font-display);font-size:1rem;color:var(--accent-strong)}
.n1{left:22%;top:34%}.n2{right:14%;top:53%}.n3{left:48%;bottom:4%}
.system-list{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}.system-list div{padding:15px 10px;border-bottom:1px solid var(--line)}.system-list div:nth-child(odd){border-right:1px solid var(--line)}.system-list span{display:block;color:var(--muted);font-size:.58rem;letter-spacing:.13em}.system-list b{display:block;margin-top:7px;font-size:.76rem}
.telemetry{display:grid;grid-template-columns:auto 1fr auto 1fr auto;align-items:center;gap:8px;margin-top:auto;padding-top:18px;color:var(--muted);font-size:.56rem;letter-spacing:.13em}.telemetry i{height:1px;background:linear-gradient(90deg,var(--accent),var(--line))}
.lower-signal{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:14px;color:var(--muted);font-size:.58rem;letter-spacing:.16em;margin-top:42px}.lower-signal i{height:1px;background:var(--line)}
.featured{padding:110px 0}.section-head{display:grid;grid-template-columns:1fr .7fr;gap:70px;align-items:end;margin-bottom:38px}.section-copy{max-width:500px;color:var(--muted-strong);line-height:1.7}.section-copy a{display:inline-block;margin-top:12px;color:var(--accent-strong);font-weight:800;font-size:.8rem}
.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.proof-band{padding:110px 0;background:color-mix(in srgb,var(--bg-elevated) 56%,transparent)}.proof-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px}.proof-steps{display:grid;gap:0}.proof-steps article{display:grid;grid-template-columns:70px 1fr;column-gap:20px;padding:24px 0;border-top:1px solid var(--line)}.proof-steps span{grid-row:1/3;color:var(--accent);font:700 1.2rem var(--font-display)}.proof-steps h3{margin:0;font-family:var(--font-display);font-size:1.35rem}.proof-steps p{margin:8px 0 0;color:var(--muted-strong);line-height:1.6}
.case-band{padding:120px 0 30px}.case-heading{max-width:820px}.case-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:44px}.case-card{padding:24px;min-height:330px;display:flex;flex-direction:column}.number{font:700 .66rem ui-monospace,SFMono-Regular,monospace;color:var(--accent);letter-spacing:.11em}.case-card h3{margin:74px 0 10px;font-family:var(--font-display);font-size:2rem;letter-spacing:-.04em}.case-card p{color:var(--muted-strong);line-height:1.65}.case-card b{margin-top:auto;color:var(--accent-strong);font-size:.8rem}
.contact-cta{margin-top:100px;padding:34px;display:flex;align-items:center;justify-content:space-between;gap:30px}.contact-cta h2{margin:7px 0 0;font-family:var(--font-display);font-size:clamp(1.8rem,4vw,3rem);max-width:820px;letter-spacing:-.04em;line-height:1}
.portfolio-lanes{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:100px}.lane{padding:28px;min-height:300px;display:flex;flex-direction:column}.lane>span{color:var(--accent);font:.64rem ui-monospace,SFMono-Regular,monospace;letter-spacing:.12em}.lane h2{font-family:var(--font-display);font-size:clamp(1.7rem,4vw,2.8rem);letter-spacing:-.04em;line-height:1;margin:64px 0 10px}.lane p{color:var(--muted-strong);line-height:1.65;max-width:600px}.lane b{margin-top:auto;color:var(--accent-strong);font-size:.78rem}@media(max-width:760px){.portfolio-lanes{grid-template-columns:1fr}}
@media(max-width:1000px){.hero-grid,.section-head,.proof-grid{grid-template-columns:1fr}.hero-system{min-height:460px}.capability-strip{grid-template-columns:repeat(2,1fr)}.capability-strip>div:nth-child(2){border-right:0}.capability-strip>div{border-bottom:1px solid var(--line)}.capability-strip>div:nth-child(3),.capability-strip>div:nth-child(4){border-bottom:0}.case-grid{grid-template-columns:1fr}.project-grid{grid-template-columns:1fr}}
@media(max-width:650px){.hero{padding-top:54px}.hero-index{margin-bottom:36px}.capability-strip{grid-template-columns:1fr}.capability-strip>div{border-right:0!important;border-bottom:1px solid var(--line)!important;padding-left:0}.capability-strip>div:last-child{border-bottom:0!important}.contact-cta{align-items:flex-start;flex-direction:column}}
</style>
