---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { featuredProjects } from "../data/projects";
---
<BaseLayout>
<section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">Business systems · workflow automation · custom software</p><h1 class="display">Systems that<br/><span>move work.</span></h1><p class="lead">I build practical software for operational workflows, integrations, automation, data visibility and internal tools — with an emphasis on clear boundaries, evidence and maintainable delivery.</p><div class="hero-actions"><a class="button primary" href="/projects">Explore projects</a><a class="button" href="/case-studies">View case studies</a></div></div><div class="hero-system panel tech-corners"><div class="system-head"><span>PORTFOLIO SYSTEM</span><span class="online">● ONLINE</span></div><div class="metric"><strong>34</strong><span>public repositories</span></div><div class="system-rule"></div><div class="system-list"><span>Flagship systems</span><b>LifeOS · Family Archive</b><span>Business systems</span><b>OperationsFlow · ClientPortal</b><span>Engineering breadth</span><b>.NET · Python · Node · Unity</b></div></div></div></section>
<section class="featured container"><div class="section-head"><div><p class="eyebrow">Selected work</p><h2 class="section-title">Built to be inspected.</h2></div><a href="/projects">All projects →</a></div><div class="project-grid">{featuredProjects.map((project,index)=><ProjectCard project={project} large={index<2}/>)}</div></section>
<section class="case-band"><div class="container"><p class="eyebrow">Case studies</p><h2 class="section-title">Context, constraints,<br/>implementation, evidence.</h2><div class="case-grid"><a class="case-card panel" href="/case-studies"><span class="number">01</span><h3>Workflow automation</h3><p>Structured operational workflows with review boundaries and evidence-oriented delivery.</p></a><a class="case-card panel" href="/case-studies"><span class="number">02</span><h3>Document intelligence</h3><p>Classification, extraction, confidence and human approval in one traceable flow.</p></a><a class="case-card panel" href="/case-studies"><span class="number">03</span><h3>Production archive</h3><p>Integrity-first media handling with duplicate review and controlled originals access.</p></a></div></div></section>
<section class="contact-cta container panel tech-corners"><div><p class="eyebrow">Available for work</p><h2>Need a system built or a workflow untangled?</h2></div><a class="button primary" href="/contact">Get in touch</a></section>
</BaseLayout>
<style>.hero{padding:clamp(70px,10vw,140px) 0 100px}.hero-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(320px,.55fr);gap:54px;align-items:end}.display span{color:var(--accent)}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}.hero-system{padding:22px;min-height:390px;display:flex;flex-direction:column}.system-head{display:flex;justify-content:space-between;color:var(--muted);font-size:.72rem;letter-spacing:.1em}.online{color:var(--success)}.metric{margin-top:auto}.metric strong{display:block;font-family:var(--font-display);font-size:5.8rem;line-height:.8;color:var(--accent-strong)}.metric span{color:var(--muted)}.system-rule{height:1px;background:var(--line);margin:24px 0}.system-list{display:grid;gap:7px;font-size:.78rem}.system-list span{color:var(--muted)}.system-list b{margin-bottom:10px}.featured{padding:70px 0 110px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:28px}.section-head>a{color:var(--accent-strong);font-weight:800}.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.case-band{border-block:1px solid var(--line);padding:100px 0;background:color-mix(in srgb,var(--bg-elevated) 70%,transparent)}.case-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:34px}.case-card{padding:22px;min-height:260px}.number{font-family:var(--font-display);color:var(--accent);font-size:1.3rem}.case-card h3{margin:54px 0 10px;font-family:var(--font-display);font-size:1.6rem}.case-card p{color:var(--muted-strong);line-height:1.6}.contact-cta{margin-top:100px;padding:34px;display:flex;align-items:center;justify-content:space-between;gap:26px}.contact-cta h2{margin:6px 0 0;font-family:var(--font-display);font-size:clamp(1.8rem,4vw,3rem);max-width:760px}@media(max-width:900px){.hero-grid,.project-grid,.case-grid{grid-template-columns:1fr}.hero-system{min-height:300px}}@media(max-width:650px){.section-head,.contact-cta{align-items:flex-start;flex-direction:column}}</style>
