---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EvidenceGallery from "../../components/EvidenceGallery.astro";
import { projects } from "../../data/projects";
import type { Project } from "../../data/projects";
import { caseStudies } from "../../data/caseStudies";

export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
const caseStudy = caseStudies.find(item => item.projectSlug === project.slug);
---
<BaseLayout title={`${project.name} — Codie Shannon`} description={project.summary}>
  <section class="container project-hero">
    <a class="back" href="/projects">← Project index</a>
    <div class="hero-grid">
      <div>
        <p class="eyebrow">{project.eyebrow}</p>
        <h1 class="section-title">{project.name}</h1>
        <p class="lead">{project.summary}</p>
        <div class="actions">
          <a class="button primary" href={project.github} target="_blank" rel="noreferrer">Open repository ↗</a>
          {caseStudy && <a class="button ghost" href={`/case-studies/${caseStudy.slug}`}>Read case study →</a>}
        </div>
      </div>
      <aside class="panel tech-corners">
        <div class="signal-head"><span>PROJECT STATE</span><i class="status-dot"></i></div>
        <strong>{project.status}</strong>
        <div class="meta"><span>Category</span><b>{project.category}</b><span>Stack</span><b>{project.stack.join(" · ")}</b></div>
      </aside>
    </div>
  </section>

  <section class="container detail-grid">
    <div class="detail-main panel">
      <p class="kicker">Role / responsibility</p>
      <h2>{project.role ?? "Implementation and technical proof."}</h2>
      <p>{project.summary}</p>
    </div>
    <div class="proof panel">
      <p class="kicker">Verified proof surfaces</p>
      <ul>{(project.proof ?? ["Repository implementation","Build / validation evidence","Public project documentation"]).map(item=><li>{item}</li>)}</ul>
    </div>
  </section>

  {project.limitation && <section class="container limitation panel tech-corners"><p class="kicker">Public boundary</p><p>{project.limitation}</p></section>}

  <div class="container"><EvidenceGallery slug={project.slug}/></div>
</BaseLayout>
<style>
.project-hero{padding:90px 0 46px}.back{display:inline-block;margin-bottom:46px;color:var(--muted);font-size:.76rem;font-weight:800}.back:hover{color:var(--accent-strong)}.hero-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:50px;align-items:end}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:30px}aside{padding:22px;min-height:250px;display:flex;flex-direction:column}.signal-head{display:flex;justify-content:space-between;color:var(--muted);font-size:.66rem;letter-spacing:.12em}aside>strong{margin-top:auto;font-family:var(--font-display);font-size:2.2rem}.meta{display:grid;grid-template-columns:auto 1fr;gap:8px 18px;margin-top:20px;padding-top:18px;border-top:1px solid var(--line);font-size:.75rem}.meta span{color:var(--muted)}.detail-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:16px}.detail-grid>div{padding:28px}.detail-main h2{font-family:var(--font-display);font-size:clamp(1.8rem,4vw,3rem);letter-spacing:-.04em;line-height:1.05;margin:16px 0}.detail-main p:last-child{color:var(--muted-strong);line-height:1.75}.proof ul{list-style:none;padding:0;margin:22px 0 0}.proof li{padding:15px 0;border-top:1px solid var(--line);color:var(--muted-strong)}.proof li::before{content:"→";color:var(--accent);margin-right:12px}.limitation{margin-top:16px;padding:28px}.limitation p:last-child{color:var(--muted-strong);line-height:1.7;max-width:940px}
@media(max-width:850px){.hero-grid,.detail-grid{grid-template-columns:1fr}}
</style>
