---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
const categories=[...new Set(projects.map(p=>p.category))];
---
<BaseLayout title="Projects — Codie Shannon"><section class="page-head container"><p class="eyebrow">Portfolio</p><h1 class="section-title">Projects</h1><p class="lead">Flagship systems, business applications, engineering labs, developer tooling and Unity work — organized by purpose rather than presented as thirty-four equal-weight repositories.</p><div class="filters"><button class="active" data-filter="all">All</button>{categories.map(c=><button data-filter={c}>{c}</button>)}</div></section><section class="container project-grid">{projects.map(project=><div data-category={project.category}><ProjectCard project={project}/></div>)}</section><script>const buttons=document.querySelectorAll("[data-filter]");const items=document.querySelectorAll("[data-category]");buttons.forEach(button=>button.addEventListener("click",()=>{buttons.forEach(b=>b.classList.remove("active"));button.classList.add("active");const target=button.dataset.filter;items.forEach(item=>item.hidden=target!=="all"&&item.dataset.category!==target)}));</script></BaseLayout>
<style>.page-head{padding:100px 0 42px}.filters{display:flex;flex-wrap:wrap;gap:8px;margin-top:30px}.filters button{border:1px solid var(--line);background:var(--panel);color:var(--muted);border-radius:999px;padding:8px 12px;cursor:pointer;font-weight:700}.filters button.active{color:#071018;background:var(--accent);border-color:var(--accent)}.project-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;padding-bottom:80px}@media(max-width:800px){.project-grid{grid-template-columns:1fr}}</style>
