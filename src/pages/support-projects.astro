---
import BaseLayout from "../layouts/BaseLayout.astro";
import { supportProjects } from "../data/supportProjects";
import { evidenceImages } from "../data/evidence";
import { projectCovers } from "../data/projectCovers";
---
<BaseLayout title="Support Projects — Codie Shannon">
<section class="container page-head"><div class="head-grid"><div><p class="eyebrow">Supporting engineering proof</p><h1 class="section-title">Tools, labs<br/>and focused proofs.</h1></div><p class="lead">Smaller repositories are separated from the flagship work so they can prove specific engineering skills without competing for equal visual weight.</p></div></section>
<section class="container support-grid">{supportProjects.map((project,index)=>{const cover=(evidenceImages[project.slug]??[])[0];return <article class="panel tech-corners"><a class="visual" href={`/support-projects/${project.slug}`}>{cover?<img src={cover.src} alt={cover.alt} loading="lazy"/>:<div class="fallback"><span>{String(index+1).padStart(2,"0")}</span><strong>{project.name.slice(0,2).toUpperCase()}</strong></div>}</a><div class="body"><div class="top"><span>{project.language||"Repository"}</span><small>{project.updatedAt}</small></div><h2><a href={`/support-projects/${project.slug}`}>{project.name}</a></h2><p>{project.description||"Focused supporting repository and technical proof."}</p><div class="actions"><a href={`/support-projects/${project.slug}`}>Inspect -&gt;</a><a href={project.github} target="_blank" rel="noreferrer">GitHub ^</a></div></div></article>})}</section>
</BaseLayout>
<style>
.head-grid{display:grid;grid-template-columns:1fr .8fr;gap:70px;align-items:end}.support-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;padding-bottom:40px}.support-grid article{overflow:hidden;display:flex;flex-direction:column;min-height:420px}.visual{height:170px;background:var(--bg-elevated);border-bottom:1px solid var(--line);overflow:hidden}.visual img{width:100%;height:100%;object-fit:cover}.fallback{height:100%;display:grid;place-items:center;position:relative;background:linear-gradient(145deg,var(--panel-strong),var(--accent-soft))}.fallback::before{content:"";position:absolute;inset:0;background-image:radial-gradient(circle,var(--grid-dot) 1px,transparent 1px);background-size:18px 18px}.fallback span{position:absolute;top:12px;left:12px;color:var(--muted);font:.62rem ui-monospace,SFMono-Regular,monospace}.fallback strong{z-index:1;font-family:var(--font-display);font-size:3rem;color:var(--accent-strong)}.body{padding:20px;display:flex;flex-direction:column;flex:1}.top{display:flex;justify-content:space-between;gap:12px;color:var(--muted);font-size:.64rem;text-transform:uppercase;letter-spacing:.08em}.body h2{font-family:var(--font-display);font-size:1.55rem;letter-spacing:-.035em;margin:24px 0 9px}.body p{color:var(--muted-strong);line-height:1.6;margin:0}.actions{display:flex;justify-content:space-between;gap:12px;margin-top:auto;padding-top:22px;border-top:1px solid var(--line);color:var(--accent-strong);font-size:.75rem;font-weight:800}@media(max-width:1000px){.support-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:680px){.head-grid,.support-grid{grid-template-columns:1fr}}
</style>
