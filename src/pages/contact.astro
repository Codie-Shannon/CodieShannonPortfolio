---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact — Codie Shannon"><section class="container contact"><p class="eyebrow">Contact</p><h1 class="section-title">Let’s build something useful.</h1><p class="lead">Available for software development, business-system work, workflow automation, integrations and practical internal tooling.</p><div class="contact-grid"><div class="panel tech-corners"><span>Email</span><strong>To be wired</strong></div><a class="panel tech-corners" href="https://github.com/Codie-Shannon" target="_blank"><span>GitHub</span><strong>Codie-Shannon ↗</strong></a><div class="panel tech-corners"><span>Location</span><strong>New Zealand</strong></div></div></section></BaseLayout>
<style>.contact{padding:110px 0 80px;min-height:70vh}.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:44px}.contact-grid>*{padding:24px;min-height:150px;display:flex;flex-direction:column;justify-content:space-between}.contact-grid span{color:var(--muted);font-size:.76rem;text-transform:uppercase;letter-spacing:.1em}.contact-grid strong{font-family:var(--font-display);font-size:1.2rem}@media(max-width:760px){.contact-grid{grid-template-columns:1fr}}</style>
