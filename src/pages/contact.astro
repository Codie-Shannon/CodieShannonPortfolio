---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact — Codie Shannon">
  <section class="container contact">
    <div class="contact-head">
      <div><p class="eyebrow">Contact</p><h1 class="section-title">Let’s build<br/>something useful.</h1></div>
      <p class="lead">Available for software development, business-system work, workflow automation, integrations and practical internal tooling.</p>
    </div>
    <div class="contact-grid">
      <div class="panel tech-corners"><span>01 / EMAIL</span><strong>Wire final address</strong><p>Direct project and contract enquiries.</p></div>
      <a class="panel tech-corners" href="https://github.com/Codie-Shannon" target="_blank" rel="noreferrer"><span>02 / GITHUB</span><strong>Codie-Shannon ↗</strong><p>Repositories, releases and implementation evidence.</p></a>
      <div class="panel tech-corners"><span>03 / LINKEDIN</span><strong>Wire final profile</strong><p>Professional history and network.</p></div>
      <div class="panel tech-corners"><span>04 / BASE</span><strong>New Zealand</strong><p>Remote, contract and selected on-site work.</p></div>
    </div>
    <div class="closing-rule"><span>REAL PROBLEM</span><i></i><span>CLEAR SCOPE</span><i></i><span>WORKING PROOF</span></div>
  </section>
</BaseLayout>
<style>
.contact{padding:110px 0 50px;min-height:72vh}.contact-head{display:grid;grid-template-columns:1fr .8fr;gap:70px;align-items:end}.contact-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:52px}.contact-grid>*{padding:26px;min-height:210px;display:flex;flex-direction:column}.contact-grid span{color:var(--accent);font:.64rem ui-monospace,SFMono-Regular,monospace;letter-spacing:.12em}.contact-grid strong{font-family:var(--font-display);font-size:clamp(1.5rem,3vw,2.3rem);margin-top:auto}.contact-grid p{color:var(--muted);line-height:1.55;margin:10px 0 0}.contact-grid a:hover{border-color:var(--accent)}
.closing-rule{display:grid;grid-template-columns:auto 1fr auto 1fr auto;gap:12px;align-items:center;margin-top:42px;color:var(--muted);font-size:.6rem;letter-spacing:.14em}.closing-rule i{height:1px;background:linear-gradient(90deg,var(--line),var(--accent),var(--line))}
@media(max-width:800px){.contact-head,.contact-grid{grid-template-columns:1fr}.closing-rule{grid-template-columns:1fr;gap:8px}.closing-rule i{display:none}}
</style>
