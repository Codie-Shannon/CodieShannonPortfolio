---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="About — Codie Shannon"><section class="container about"><div><p class="eyebrow">About</p><h1 class="section-title">Practical systems.<br/>Clear evidence.</h1><p class="lead">I’m Codie Shannon, a New Zealand software developer and contractor focused on business systems, workflow automation, integrations, internal tools and operational software.</p><p class="copy">My work spans C#/.NET desktop and web development, Microsoft 365 and Power Platform workflows, Python/FastAPI, Node/TypeScript/Vue, SQL, document processing, QA tooling and Unity development.</p><p class="copy">I use a consistent engineering process across projects: scoped implementation, deterministic validation, CI, public-data boundaries, evidence and versioned closure.</p></div><aside class="panel tech-corners"><p class="eyebrow">Profile</p><div class="avatar">CS</div><h2>Codie Shannon</h2><p>Business Systems & Workflow Automation Contractor</p><div class="facts"><span>Based in</span><b>New Zealand</b><span>Core</span><b>.NET · Automation · Data</b><span>Also</span><b>Python · Node · Unity</b></div></aside></section></BaseLayout>
<style>.about{padding:110px 0 80px;display:grid;grid-template-columns:1.35fr .65fr;gap:54px;align-items:start}.copy{max-width:760px;color:var(--muted-strong);line-height:1.75;font-size:1.03rem}aside{padding:24px}.avatar{width:100%;aspect-ratio:1.25;display:grid;place-items:center;background:linear-gradient(145deg,var(--panel-strong),var(--accent-soft));border:1px solid var(--line);font-family:var(--font-display);font-size:4rem;color:var(--accent)}aside h2{font-family:var(--font-display);font-size:2rem;margin:22px 0 5px}aside>p:not(.eyebrow){color:var(--muted)}.facts{display:grid;grid-template-columns:auto 1fr;gap:8px 18px;margin-top:24px;padding-top:20px;border-top:1px solid var(--line);font-size:.82rem}.facts span{color:var(--muted)}@media(max-width:850px){.about{grid-template-columns:1fr}}</style>
