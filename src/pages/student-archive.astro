---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReadmePanel from "../components/ReadmePanel.astro";
import { studentArchive, studentArchiveItems } from "../data/studentArchive";
import { repoDetails } from "../data/repoDetails";
const detail=repoDetails["student-work-archive"];
---
<BaseLayout title="Student Archive — Codie Shannon">
<section class="container page-head"><div class="head-grid"><div><p class="eyebrow">Historical / student work</p><h1 class="section-title">Origin work,<br/>kept in context.</h1></div><div><p class="lead">Earlier diploma and student projects live here instead of competing with current professional work. They show progression, breadth and the starting point behind later systems.</p>{studentArchive.github&&<a class="button ghost archive-link" href={studentArchive.github} target="_blank" rel="noreferrer">Open student-work-archive ^</a>}</div></div></section>
<section class="container archive-grid">{studentArchiveItems.map((item,index)=><article class="panel"><span>{String(index+1).padStart(2,"0")}</span><h2>{item.name}</h2><p>{item.description}</p>{item.stack.length>0&&<div class="tags">{item.stack.map(x=><small>{x}</small>)}</div>}</article>)}</section>
<div class="container"><ReadmePanel detail={detail}/></div>
</BaseLayout>
<style>
.head-grid{display:grid;grid-template-columns:1fr .8fr;gap:70px;align-items:end}.archive-link{margin-top:24px}.archive-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:30px}.archive-grid article{padding:22px;min-height:240px}.archive-grid article>span{color:var(--accent);font:.66rem ui-monospace,SFMono-Regular,monospace}.archive-grid h2{font-family:var(--font-display);font-size:1.45rem;margin:42px 0 8px;letter-spacing:-.035em}.archive-grid p{color:var(--muted-strong);line-height:1.58}.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:17px}.tags small{border:1px solid var(--line);border-radius:999px;padding:5px 7px;color:var(--muted)}@media(max-width:900px){.head-grid,.archive-grid{grid-template-columns:1fr}}
</style>
